    <div class="SpeechName">Nurse.</div>

    <div class="Speech">
   I don't know what you can see... but I must INSIST that you get some rest, otherwise you may end up hurting yourself even further, which you don't want to do.
    <p>
    
    <p>
          <div class="SpeechContinueButton">
       
  </div>
  </div>
</div>

(after: 10s)[(goto: "OverlordOnlyWantsYouToBeStrong")]


