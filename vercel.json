{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --legacy-peer-deps && npm ci --prefix portfolio",
  "buildCommand": "npm run build:beta",
  "outputDirectory": "portfolio/dist",
  "functions": {
    "api/education.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/fxtwitter/:path*",
      "destination": "https://api.fxtwitter.com/:path*"
    },
    {
      "source": "/api/sanity-public/:version/data/query/:dataset",
      "destination": "/api/education"
    }
  ]
}
